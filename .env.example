# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and must never be committed.
#
# These are the only variables the site reads. Everything else that
# used to live here belonged to demos and routes that have since been
# removed.

# Claude API. Powers every AI backed demo and project: Illoca, Terranox,
# Whop, SideShift, Midjourney, Rho, World Labs, the Datum brief,
# Fine Print, and Acoustic Form.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend. Sends the contact and feedback form on the home page.
# https://resend.com
RESEND_API_KEY=

# World Labs. Generates and polls Marble worlds for the Ekphrasis demo.
# API credits are separate from Marble app credits.
# https://platform.worldlabs.ai/api-keys
WORLDLABS_API_KEY=

# Census Bureau API key. Datum demographics layer. Without it the layer
# returns an unavailable envelope with the code missing_key.
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Supabase project URL for the Datum cache, site records, and rate limit.
SUPABASE_URL=

# Supabase secret key (an sb_secret_ key). Server only. Never prefix it
# with NEXT_PUBLIC_ and never return it in a response.
SUPABASE_SECRET_KEY=

# Set to 1 in local and preview only. Lets the Datum site route accept
# isTest so acceptance runs do not pollute Site Memory. Unset in production.
DATUM_ALLOW_TEST_FLAG=

# Tests only. JSON map of Datum source name to base URL, honoured only
# when NODE_ENV is not production. Used to point a source at an
# unreachable port and assert the unavailable state.
DATUM_SOURCE_OVERRIDES=

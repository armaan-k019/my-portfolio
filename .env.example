# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and must never be committed.
#
# These four are the only variables the site reads. Everything else that
# used to live here belonged to demos and routes that have since been
# removed.

# Claude API. Powers every AI backed demo and project: Illoca, Terranox,
# Whop, SideShift, Midjourney, Rho, World Labs, the UrbanGPT narrative,
# Fine Print, and Acoustic Form.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend. Sends the contact and feedback form on the home page.
# https://resend.com
RESEND_API_KEY=

# Eventbrite. Supplies the events feed on the Pulse project page.
# https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=

# World Labs. Generates and polls Marble worlds for the Ekphrasis demo.
# API credits are separate from Marble app credits.
# https://platform.worldlabs.ai/api-keys
WORLDLABS_API_KEY=
